# Chuyen hai minh v2: local Node / Docker with persistent SQLite.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
UPLOAD_DIR=./uploads

# HTTP localhost: false / 0. HTTPS behind the Caddy profile: true / 1.
COOKIE_SECURE=false
TRUST_PROXY=0

# Optional real domain for: docker compose --profile https up -d --build
APP_DOMAIN=localhost

# Optional ICE provider for WebRTC across Internet/NAT.
STUN_URL=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Existing .env SQL values may remain; v2 does not use them.
